# Run: node scripts/generate-env.mjs https://tracker.example.com
# GLOBAL_API_KEY opens the shared administration interface.
GLOBAL_API_KEY=REPLACE_WITH_RANDOM_GLOBAL_API_KEY
# 32 random bytes, encoded as exactly 64 hexadecimal characters.
# Keep this key with the database backup; changing it makes stored secrets unreadable.
ENCRYPTION_KEY=REPLACE_WITH_64_HEX_CHARACTERS

# Origin only: no path, query string or trailing application prefix.
PUBLIC_BASE_URL=http://localhost:7000

# Simkl OAuth application. Register this callback in Simkl:
# https://tracker.example.com/oauth/simkl/callback
SIMKL_CLIENT_ID=
SIMKL_CLIENT_SECRET=
# Optional account token available when configuring a profile.
SIMKL_ACCESS_TOKEN=

# PublicMetaDB personal API key, optional default for a profile.
PMDB_API_KEY=

# Background tracker refresh. Minimum accepted by the app: 30 seconds.
SYNC_INTERVAL_SECONDS=300

# Align these with AIOStreams limits if your history exceeds its defaults.
MAX_PULL_BYTES=4900000
MAX_RESUME_ITEMS=5000
MAX_WATCHED_MOVIES=50000
MAX_WATCHED_EPISODES=50000

# Native Node run only; Compose sets these three values inside the container.
HOST=0.0.0.0
PORT=7000
DATA_DIR=./data

# Host publication for Compose. Use 0.0.0.0 only to publish to all host interfaces.
HOST_BIND=127.0.0.1
HOST_PORT=7000

# Prebuilt GHCR image used only by compose.ghcr.yaml (tag or @sha256 digest).
AIOSYNC_IMAGE=ghcr.io/docloulou/aiosync:latest
